{
    "name": "echarts-mcp",
    "version": "1.0.0",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "inspect": "mcp-inspector --server-url http://localhost:8081/mcp --transport http",
        "start:stdio": "node src/index.js --stdio",
        "inspect:stdio": "mcp-inspector --web node src/index.js --stdio"
    },
    "keywords": ["echarts", "mcp", "data-visualization"],
    "author": "Apache ECharts Team",
    "description": "Apache ECharts MCP Server",
    "dependencies": {
        "@baiducloud/sdk": "^1.0.7",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "canvas": "^3.2.3",
        "dotenv": "^17.4.2",
        "echarts": "^6.1.0",
        "express": "^5.2.1"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^2.6.0",
        "nodemon": "^3.1.14"
    }
}
